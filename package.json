{
  "name": "kelontong-dashboard",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "oxlint && eslint \"apps/**/*.vue\"",
    "lint:fix": "oxlint --fix && eslint --fix \"apps/**/*.vue\"",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter backend test:e2e",
    "db:migrate": "pnpm --filter backend db:migrate",
    "db:seed": "pnpm --filter backend db:seed"
  },
  "devDependencies": {},
  "dependencies": {
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "oxlint": "^1.89.0",
    "typescript": "~6.0.3",
    "vue-eslint-parser": "^10.4.1"
  }
}
